# 部署密钥（示例）。复制为 <state>/deployment/.env，chmod 600，并填入真实值。
# 密钥只放在这里；config.json 里写变量名，不写值。

# Web 控制台
CORTICO_WEB_PASSWORD=

# Provider
DEEPSEEK_API_KEY=
CORTICO_KEY_OPENCODE=
CORTICO_KEY_DOUBAO=
CORTICO_GOOGLE_CLOUD_API_KEY=

# 通道
TINA_MOBILE_TOKEN=
CORTICO_TINALINK_TOKEN=
CORTICO_WORK_BRIDGE_TOKEN=

# 可选：机器人 / 桌宠
CORTICO_CANBOT_API_TOKEN=
CORTICO_CANBOT_AVATAR_TOKEN=
CORTICO_CANBOT_MEDIA_TOKEN=
CORTICO_CANBOT_VOICE_TOKEN=

# 可选：记忆 HTTP 跨设备认证
TINA_SELF_MEM_TOKEN=

# 可选：被动采集的受保护目录（逗号分隔，永远不扫描）
TINA_PROTECTED_DIRS=
