{
  "name": "tina-cordis",
  "version": "0.2.0-fusion.9",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "exports": {
    ".": "./src/fusion-app.mjs",
    "./native-session": "./src/dsh-native-session.mjs",
    "./world": "./src/fusion-world.mjs",
    "./provider": "./src/fusion-provider.mjs",
    "./session-head": "./src/fusion-session-head.mjs",
    "./prompts": "./src/fusion-prompts.mjs",
    "./extensions": "./src/fusion-extensions.mjs",
    "./legacy-runtime": "./src/plugin-runtime.mjs",
    "./autonomy-policy": "./src/fusion-autonomy-policy.mjs",
    "./model-controls": "./src/fusion-model-controls.mjs",
    "./launcher": "./src/fusion-launcher.mjs",
    "./execution-policy": "./src/fusion-execution-policy.mjs",
    "./tool-presentation": "./src/fusion-tool-presentation.mjs",
    "./tool-results": "./src/fusion-tool-results.mjs",
    "./host": "./src/host-entry.mjs",
    "./plugin-runtime": "./src/plugin-runtime.mjs",
    "./session-identity": "./src/session-identity.mjs"
  },
  "scripts": {
    "prestart": "node --expose-internals --import ./upstream/cortico/node_modules/tsx/dist/loader.mjs scripts/setup-fusion-memory.mjs",
    "start": "node src/fusion-launcher.mjs",
    "prefusion": "node --expose-internals --import ./upstream/cortico/node_modules/tsx/dist/loader.mjs scripts/setup-fusion-memory.mjs",
    "setup:memory": "node --expose-internals --import ./upstream/cortico/node_modules/tsx/dist/loader.mjs scripts/setup-fusion-memory.mjs",
    "app": "node src/fusion-launcher.mjs",
    "legacy:app": "node --expose-internals src/legacy/app.mjs",
    "inspect": "node --expose-internals src/legacy/cli.mjs --inspect",
    "test": "node --expose-internals --import ./upstream/cortico/node_modules/tsx/dist/loader.mjs --test --test-concurrency=2 test/*.test.mjs",
    "test:app": "node --expose-internals integration/smoke-app.mjs",
    "fusion": "node src/fusion-launcher.mjs",
    "build:fusion": "pnpm --dir upstream/cortico run build:web",
    "build:native": "node scripts/build-fusion-native.mjs",
    "test:fusion": "node --expose-internals --import ./upstream/cortico/node_modules/tsx/dist/loader.mjs --test --test-concurrency=2 test/fusion-*.test.mjs",
    "bench:efficiency": "node --expose-internals --import ./upstream/cortico/node_modules/tsx/dist/loader.mjs integration/fusion-efficiency-benchmark.mjs",
    "package": "node scripts/package-host-plugin.mjs",
    "build:compat": "node scripts/build-host-compat.mjs",
    "test:host": "node --expose-internals --import ./upstream/cortico/node_modules/tsx/dist/loader.mjs --test --test-concurrency=1 test/host-*.test.mjs",
    "package:standalone": "node scripts/package-fusion.mjs",
    "package:host": "node scripts/package-host-plugin.mjs",
    "package:memory": "node scripts/package-self-mem.mjs",
    "test:structure": "node --test test/source-distribution.test.mjs",
    "test:legacy": "node --expose-internals --import ./upstream/cortico/node_modules/tsx/dist/loader.mjs --test --test-concurrency=1 test/legacy/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "file:vendor/deepseek-ai-cordis-4.0.2.tgz",
    "@deepseek-ai/cordis-plugin-include": "file:vendor/deepseek-ai-cordis-plugin-include-1.0.7.tgz",
    "@deepseek-ai/cordis-plugin-loader": "file:vendor/deepseek-ai-cordis-plugin-loader-1.0.3.tgz",
    "@deepseek-ai/cosmokit": "file:vendor/deepseek-ai-cosmokit-1.8.3.tgz",
    "@standard-schema/spec": "file:vendor/standard-schema-spec-1.1.0.tgz",
    "argparse": "file:vendor/argparse-2.0.1.tgz",
    "js-yaml": "file:vendor/js-yaml-4.2.0.tgz",
    "ajv": "file:vendor/ajv-8.20.0.tgz",
    "ajv-formats": "file:vendor/ajv-formats-3.0.1.tgz",
    "fast-deep-equal": "file:vendor/fast-deep-equal-3.1.3.tgz",
    "fast-uri": "file:vendor/fast-uri-3.1.3.tgz",
    "json-schema-traverse": "file:vendor/json-schema-traverse-1.0.0.tgz",
    "require-from-string": "file:vendor/require-from-string-2.0.2.tgz"
  },
  "description": "Canonical Cortico Persona, Memory and World composition on one native Cordis/DSH runtime; standalone and host-plugin entries."
}
