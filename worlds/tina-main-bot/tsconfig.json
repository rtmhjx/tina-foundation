{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "cortico/*": [
        "../../upstream/cortico/src/*"
      ]
    }
  },
  "include": [
    "index.ts",
    "tests/*.ts"
  ]
}
