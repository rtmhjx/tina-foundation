+  /** An execution host released this exact instance; deployment intent is unchanged. */
+  detached(instance: World, { retainInstance = false }: { retainInstance?: boolean } = {}): void {
+    const slot = this.slots.find((entry) => entry.instance === instance);
+    if (!slot) return;
+    const index = this.mounted.indexOf(instance);
+    if (index >= 0) this.mounted.splice(index, 1);
+    slot.mounted = false;
+    delete slot.failure;
+    this.host?.lifecycle?.({ kind: 'unmounted', id: slot.id, label: slot.label });
+    if (slot.definition && !retainInstance) {
+      try { slot.instance = slot.definition.create(this.context(slot.definition)); }
+      catch (error) {
+        const reason = error instanceof Error ? error.message : String(error);
+        this.slots.splice(this.slots.indexOf(slot), 1);
+        this.missing.push({ id: slot.id, label: slot.label, declared: slot.declared,
+          reason: (language) => text(language).constructFailed(reason) });
+      }
+    }
+  }
+
+  /** Restore the same instance after its runtime owner restarted it. */
+  restored(instance: World): void {
+    const slot = this.slots.find((entry) => entry.instance === instance);
+    if (!slot) return;
+    slot.mounted = true;
+    delete slot.failure;
+    this.host?.lifecycle?.({ kind: 'restarted', id: slot.id, label: slot.label });
+  }
+
